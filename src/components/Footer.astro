---
import siteConfig from '../../site.config.mjs';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
const owner = siteConfig.owner;
const phone = siteConfig.phone;
const email = siteConfig.email;
const address = siteConfig.address;
const socialLinks = siteConfig.socialLinks;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-gray-900 text-gray-300 py-16 mt-auto">
	<div class="container mx-auto px-6">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
			<div>
				<img
					src={`${siteConfig.logoLight}`}
					class="h-12 w-auto mb-4"
					alt={owner}
					onerror="this.style.display='none'"
				/>
				<p class="text-sm text-gray-500 leading-relaxed">
					Fotógrafo profesional en Santo Domingo. Capturando tus momentos más especiales con
					dedicación y pasión.
				</p>
			</div>

			<div>
				<h4 class="text-white text-xs tracking-[0.3em] uppercase mb-6">Navegación</h4>
				<ul class="space-y-3 text-sm">
					<li><a href={`${base}`} class="hover:text-white transition-colors">Inicio</a></li>
					<li>
						<a href={`${base}/collections`} class="hover:text-white transition-colors">Portafolio</a
						>
					</li>
					<li>
						<a href={`${base}/about`} class="hover:text-white transition-colors">Sobre mí</a>
					</li>
					<li>
						<a href={`${base}/contacto`} class="hover:text-white transition-colors">Contacto</a>
					</li>
				</ul>
			</div>

			<div>
				<h4 class="text-white text-xs tracking-[0.3em] uppercase mb-6">Contacto</h4>
				<ul class="space-y-3 text-sm">
					<li>
						<a href={`tel:${phone}`} class="hover:text-white transition-colors">{phone}</a>
					</li>
					<li>
						<a href={`mailto:${email}`} class="hover:text-white transition-colors">{email}</a>
					</li>
					<li class="text-gray-500">{address}</li>
				</ul>
			</div>
		</div>

		<div
			class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
		>
			<p class="text-xs text-gray-600">
				{year} © {owner}. Todos los derechos reservados.
			</p>
			<div class="flex space-x-5">
				{socialLinks.map((socialLink) => <SocialIcon socialLink={socialLink} />)}
			</div>
		</div>
	</div>
</footer>
