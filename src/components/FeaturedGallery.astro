---
import PhotoGrid from './PhotoGrid.astro';
import { featuredCollectionId, getImages } from '../data/imageStore';

const images = await getImages({ collection: featuredCollectionId });
---

<div class="max-w-2xl mx-auto text-center mb-16 scroll-fade-up">
	<p class="text-xs tracking-[0.4em] uppercase text-gray-400 mb-4">Portafolio</p>
	<h2 class="text-3xl md:text-4xl font-bold mb-4">Momentos Inolvidables</h2>
	<p class="text-gray-500 leading-relaxed">
		Una selección de los mejores momentos capturados a lo largo de los años.
	</p>
</div>
<div class="p-4">
	<PhotoGrid images={images} />
</div>
