---
import siteConfig from '../../site.config.mjs';

const owner = siteConfig.owner;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = siteConfig.email;
const phone = siteConfig.phone;
const whatsapp = siteConfig.whatsapp;
---

<div class="container mx-auto px-6 text-center">
	<p class="text-xs tracking-[0.4em] uppercase text-gray-400 mb-6 scroll-fade-up">Siguiente paso</p>
	<h2 class="text-3xl md:text-5xl font-bold text-white mb-6 scroll-fade-up stagger-1">
		¿Te gusta lo que ves?
	</h2>
	<p class="text-xl text-gray-300 mb-4 font-light scroll-fade-up stagger-2">
		Hagamos de tus fotos una realidad
	</p>
	<p class="text-gray-400 max-w-xl mx-auto mb-12 leading-relaxed scroll-fade-up stagger-3">
		Contáctame para dar el siguiente paso. Me encantaría saber más sobre ti y tu historia.
	</p>

	<div
		class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16 scroll-fade-up stagger-4"
	>
		<a
			href={`${base}/contacto`}
			class="inline-block px-10 py-4 bg-white text-black font-medium tracking-widest uppercase text-sm
                   hover:bg-gray-100 transition-all duration-300"
		>
			Reserva tu sesión
		</a>
		<a
			href={`https://wa.me/${whatsapp}?text=Hola%20${encodeURIComponent(owner)}!%20Quiero%20realizar%20una%20sesion%20de%20fotos.`}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-block px-10 py-4 border-2 border-white text-white font-medium tracking-widest uppercase text-sm
                   hover:bg-white hover:text-black transition-all duration-300"
		>
			Escríbeme por WhatsApp
		</a>
	</div>

	<div
		class="flex flex-col sm:flex-row justify-center items-center gap-8 text-gray-400 text-sm scroll-fade-up stagger-5"
	>
		<a href={`tel:${phone}`} class="hover:text-white transition-colors duration-200">
			{phone}
		</a>
		<span class="hidden sm:block text-gray-600">·</span>
		<a href={`mailto:${email}`} class="hover:text-white transition-colors duration-200">
			{email}
		</a>
	</div>
</div>
