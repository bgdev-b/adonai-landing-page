---
import siteConfig from '../../site.config.mjs';

const owner = siteConfig.owner;
const heroImage = siteConfig.heroImage;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="absolute inset-0 bg-gray-900">
	<div
		class="absolute inset-0 bg-cover bg-center bg-no-repeat"
		style={`background-image: url('${heroImage}')`}
	>
	</div>
	<div class="absolute inset-0 bg-black/55"></div>
</div>

<div class="relative z-10 w-full text-center text-white px-4 py-32 md:py-40">
	<p
		class="text-xs md:text-sm tracking-[0.4em] uppercase mb-6 text-gray-300 fade-down"
		style="animation-delay: 200ms"
	>
		República Dominicana
	</p>
	<p
		class="text-sm md:text-base italic text-gray-200 mb-4 font-light fade-in"
		style="animation-delay: 500ms"
	>
		Capturando momentos auténticos e historias reales
	</p>
	<h1
		class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight mb-8 uppercase tracking-wide fade-up"
		style="animation-delay: 700ms"
	>
		{owner}
		<span class="block text-2xl md:text-3xl lg:text-4xl font-light mt-2 tracking-[0.2em]">
			Fotografía
		</span>
	</h1>
	<p
		class="text-base md:text-lg text-gray-200 max-w-2xl mx-auto mb-10 font-light leading-relaxed fade-up"
		style="animation-delay: 950ms"
	>
		Desde bodas íntimas hasta grandes celebraciones, capturamos tu historia única con dedicación y
		profesionalismo.
	</p>
	<a
		href={`${base}/collections`}
		class="inline-block px-10 py-4 border-2 border-white text-white font-medium tracking-widest uppercase text-sm
               hover:bg-white hover:text-black transition-all duration-300 fade-up"
		style="animation-delay: 1150ms"
	>
		Ver Galería
	</a>
</div>
