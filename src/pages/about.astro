---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as AboutPage } from '../content/about.md';
import siteConfig from '../../site.config.mjs';

const owner = siteConfig.owner;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<MainLayout>
	<section class="pt-32 pb-20">
		<div class="container mx-auto px-6">
			<div class="max-w-2xl mx-auto text-center mb-16">
				<p class="text-xs tracking-[0.4em] uppercase text-gray-400 mb-4">Conóceme</p>
				<h1 class="text-4xl md:text-5xl font-bold mb-4">Sobre mí</h1>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div
					class="relative bg-gray-100 aspect-[2/3] flex items-center justify-center shadow-xl overflow-hidden"
				>
					<div class="text-center text-gray-400 select-none pointer-events-none">
						<svg
							class="w-20 h-20 mx-auto mb-4 text-gray-300"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="1"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
						</svg>
						<p class="text-sm font-medium tracking-widest uppercase">Foto de Adonai</p>
						<p class="text-xs mt-1">Próximamente</p>
					</div>
				</div>

				<div class="prose prose-lg text-gray-700">
					<AboutPage />
				</div>
			</div>
		</div>
	</section>
</MainLayout>
