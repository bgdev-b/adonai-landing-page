---
import MainLayout from '../layouts/MainLayout.astro';
import siteConfig from '../../site.config.mjs';

const owner = siteConfig.owner;
const email = siteConfig.email;
const phone = siteConfig.phone;
const whatsapp = siteConfig.whatsapp;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const benefits = [
	'Consulta inicial sin costo',
	'Propuesta personalizada a tu evento',
	'Comunicación directa y clara',
	'Acompañamiento en todo el proceso',
];

const serviceOptions = [
	'Boda',
	'Sesión de novios',
	'Quinceañera',
	'Retratos',
	'Embarazo',
	'Familiar',
	'Evento corporativo',
	'Otro',
];
---

<MainLayout>
	<section class="pt-32 pb-20 min-h-screen">
		<div class="container mx-auto px-6">
			<div class="max-w-xl mb-16">
				<p class="text-xs tracking-[0.4em] uppercase text-gray-400 mb-4">Hablemos</p>
				<h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
					Hablemos de tu sesión de fotos
				</h1>
				<p class="text-gray-500 text-lg leading-relaxed">
					Cuéntame sobre tu historia y conversemos sobre la mejor forma de capturarla. Sin
					compromiso.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
				<div>
					<ul class="space-y-4 mb-12">
						{
							benefits.map((benefit) => (
								<li class="flex items-center gap-3 text-gray-600">
									<svg
										class="w-5 h-5 text-gray-400 shrink-0"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
									</svg>
									{benefit}
								</li>
							))
						}
					</ul>

					<hr class="border-gray-200 mb-10" />

					<p class="text-sm text-gray-400 mb-3">¿Tienes preguntas? Contáctame directamente:</p>
					<div class="space-y-2">
						<a
							href={`tel:${phone}`}
							class="block font-semibold text-gray-800 hover:text-black transition-colors"
						>
							{phone}
						</a>
						<a
							href={`mailto:${email}`}
							class="block font-semibold text-gray-800 hover:text-black transition-colors"
						>
							{email}
						</a>
						<a
							href={`https://wa.me/${whatsapp}?text=Hola%20${encodeURIComponent(owner)}!%20Quiero%20realizar%20una%20sesion%20de%20fotos.`}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-black transition-colors mt-2"
						>
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path
									d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
								></path>
							</svg>
							Escríbeme por WhatsApp
						</a>
					</div>
				</div>

				<div class="bg-white border border-gray-100 rounded-xl shadow-sm p-8 md:p-10">
					<form class="space-y-6">
						<div>
							<label for="nombre" class="block text-sm font-semibold text-gray-700 mb-2">
								Nombre completo
							</label>
							<input
								type="text"
								id="nombre"
								name="nombre"
								placeholder="Juan Pérez"
								class="w-full px-4 py-3 border border-gray-200 rounded-lg text-gray-800 placeholder-gray-400
                                       focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition-colors"
							/>
						</div>

						<div>
							<label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
								Correo electrónico
							</label>
							<input
								type="email"
								id="email"
								name="email"
								placeholder="juan@ejemplo.com"
								class="w-full px-4 py-3 border border-gray-200 rounded-lg text-gray-800 placeholder-gray-400
                                       focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition-colors"
							/>
						</div>

						<div>
							<label for="telefono" class="block text-sm font-semibold text-gray-700 mb-2">
								Teléfono (opcional)
							</label>
							<input
								type="tel"
								id="telefono"
								name="telefono"
								placeholder="(809) 000-0000"
								class="w-full px-4 py-3 border border-gray-200 rounded-lg text-gray-800 placeholder-gray-400
                                       focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition-colors"
							/>
						</div>

						<div>
							<label for="servicio" class="block text-sm font-semibold text-gray-700 mb-2">
								Tipo de servicio
							</label>
							<select
								id="servicio"
								name="servicio"
								class="w-full px-4 py-3 border border-gray-200 rounded-lg text-gray-800
                                       focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition-colors bg-white"
							>
								<option value="" disabled selected>Selecciona un servicio</option>
								{serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
							</select>
						</div>

						<div>
							<label for="mensaje" class="block text-sm font-semibold text-gray-700 mb-2">
								Cuéntame sobre tu sesión
							</label>
							<textarea
								id="mensaje"
								name="mensaje"
								rows="4"
								placeholder="Describe brevemente tu evento, fecha aproximada, lugar y cualquier detalle importante."
								class="w-full px-4 py-3 border border-gray-200 rounded-lg text-gray-800 placeholder-gray-400 resize-none
                                       focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition-colors"
							></textarea>
						</div>

						<button
							type="button"
							class="w-full py-4 bg-gray-800 text-white font-semibold tracking-wider uppercase text-sm
                                   hover:bg-black transition-colors duration-300 rounded-lg"
						>
							Hablemos de tu sesión
						</button>
					</form>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
