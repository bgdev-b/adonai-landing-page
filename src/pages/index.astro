---
import MainLayout from '../layouts/MainLayout.astro';
import LandingHero from '../components/LandingHero-1.astro';
import FeaturedWorkScroll from '../components/FeaturedWorkScroll.astro';
import AboutSection from '../components/AboutSection.astro';
import WhyChooseMe from '../components/WhyChooseMe.astro';
import ServicesSection from '../components/ServicesSection.astro';
import FeaturedGallery from '../components/FeaturedGallery.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<MainLayout>
	<section class="relative min-h-screen flex items-center overflow-hidden">
		<LandingHero />
		<FeaturedWorkScroll />
	</section>

	<section class="py-24 bg-white">
		<AboutSection />
	</section>

	<section class="py-24 bg-gray-50">
		<WhyChooseMe />
	</section>

	<section class="py-24 bg-white">
		<ServicesSection />
	</section>

	<section class="py-24 bg-gray-50">
		<div class="container mx-auto px-6">
			<FeaturedGallery />
		</div>
	</section>

	<section class="py-24 bg-white">
		<ProcessSection />
	</section>

	<section id="contacto" class="py-24 bg-gray-900">
		<ContactCTA />
	</section>
</MainLayout>
